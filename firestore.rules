rules_version = '2';

// Starfish Firestore rules. These are what enforce access for the web UI, which
// reads and triages incidents straight from Firestore.
//
// The engine (src/) writes with the Admin SDK and bypasses these rules.
//
// Deploy these to Starfish's OWN named database (firebase.json targets
// "starfish"), never to your app's default database: a rules file governs a
// whole database, so deploying this one there would replace your app's rules.
//
// Collection names below are the defaults. If you configure different ones
// (STARFISH_INCIDENT_COLLECTION / VITE_STARFISH_INCIDENT_COLLECTION,
// VITE_STARFISH_USERS_COLLECTION), change them here too: this file is
// deployment config, like firestore.indexes.json. The engine's incident keys
// (STARFISH_INCIDENT_KEY_COLLECTION, "incident_keys") are engine-only and fall
// to the closing rule at the bottom. The runtime settings use starfish_settings
// (STARFISH_SETTINGS_COLLECTION), with their operator copy and audit trail in
// starfish_settings_public and starfish_settings_audit. The ingest run records use
// starfish_runs (STARFISH_RUN_COLLECTION); the agent cycles and their run events use
// starfish_cycles (STARFISH_CYCLE_COLLECTION); the audit trail of admin actions on the
// engine uses starfish_audit (STARFISH_AUDIT_COLLECTION). The on-call rota uses starfish_oncall and
// starfish_oncall_people (STARFISH_ONCALL_COLLECTION, STARFISH_ONCALL_PEOPLE_COLLECTION); the call sequences,
// starfish_escalations (STARFISH_ESCALATION_COLLECTION), are engine-only. The guests' trimmed copies (#18) use
// starfish_public_incidents, starfish_public_cycles and starfish_public_events (STARFISH_PUBLIC_INCIDENT_COLLECTION,
// STARFISH_PUBLIC_CYCLE_COLLECTION, STARFISH_PUBLIC_EVENT_COLLECTION).
//
// Model: roles live on an operator record and are read fresh on every request,
// never cached in a token.
service cloud.firestore {
  match /databases/{database}/documents {

    function operatorRoles() {
      return get(/databases/$(database)/documents/starfish_users/$(request.auth.uid)).data.roles;
    }

    function isOperator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/starfish_users/$(request.auth.uid))
        && operatorRoles().hasAny(['admin', 'operator']);
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/starfish_users/$(request.auth.uid))
        && operatorRoles().hasAny(['admin']);
    }

    // A GUEST is an anonymous Firebase Auth session. The public demo signs every visitor in
    // silently so a judge needs no account (issue #12). Guests are read-only and see the demo
    // environment and nothing else: no operator records, no settings, no audit trail, no
    // writes. The provider check matters: a signed-in user with NO role (an email account) is
    // not a guest and still reads nothing. Rules never let a guest write, even where the public
    // demo's actions are on: those go through the admin API (src/publicDemo.ts), not these rules.
    //
    // A guest never reads a stored incident, cycle or run event (#18), unless a deployment opens the public
    // demo's reads (publicAccessOn, below, off by default): redaction is pattern
    // matching, so free text in them can still hold personal data it does not recognise. A guest
    // reads the TRIMMED COPIES instead (starfish_public_*, below): allowlist projections the
    // engine writes for the demo environment (src/publicView.ts), holding ids, statuses, counts,
    // times, names, a bounded one-line title, links and the run record's enumerated values. Besides
    // those, a guest reads only last_run, starfish_runs/agent_last_run, starfish_runs/integrations and
    // the operator copy of the settings, which holds no production text: the environment label, the
    // watched project and the settings in force as an admin saved them, shown read-only. Secrets are
    // never in the settings (settingsShapeOk rejects any other key), and the copy leaves out who saved.
    //
    // The demo environment label below is the default for the public demo, like the collection
    // names above: change it here if the demo deploys under another label (and in
    // web/src/lib/dataSource.ts, whose label decides whether sign-in offers the guest view). A private
    // deployment simply leaves Anonymous sign-in disabled in the Firebase console, and this
    // never matches.
    function isGuest() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // A guest's single-document read. A document that does not exist has no environment
    // (`resource` is null, and reading resource.data would deny the get), yet the UI must tell a
    // guest "not reached" or "no run recorded" rather than show a read error (issue #142). So a
    // guest may get a missing document: the answer is "it doesn't exist", which holds no data.
    // It does tell a missing id from a non-demo one, which matters only to someone who already
    // knows that id. Lists never use this: a guest's query must filter on environment == 'demo'.
    function guestGet() {
      return isGuest() && (resource == null || resource.data.environment == 'demo');
    }

    // A guest's query must also carry a limit, at most 500 documents (the most the UI asks for: the Runs
    // page's "show more", CYCLE_LIMIT_MAX in web/src/lib/runs.ts). Anyone can mint a guest session, and
    // a query is billed per document it returns: without a limit, a script could read every copy on
    // every request, and the event copies only grow.
    function guestList() {
      return isGuest() && resource.data.environment == 'demo'
        && request.query.limit is int && request.query.limit <= 500;
    }

    // The public demo's OPEN READS (src/publicDemo.ts): where a deployment turns the public demo's actions on
    // (STARFISH_PUBLIC_DEMO_ACTIONS, off by default), a guest also reads the FULL stored incidents, their corrections,
    // cycles and run events of the demo environment, not only the trimmed copies. Rules cannot read the engine's
    // settings, so the gate is a document only the engine writes (the admin API, as it starts; the closing rule
    // keeps every client off it): starfish_runs/public_access, `enabled: true` and `environment: 'demo'`. Without
    // it, or with anything else in it, a guest reads the trimmed copies alone, as before. The guest rules above
    // still apply on top: the demo environment only, and a query's limit at most 500. A guest still WRITES nothing:
    // a visitor's actions go through the admin API, which counts them per address (src/publicDemoLimit.ts).
    // Collection name: STARFISH_RUN_COLLECTION, like last_run below.
    function publicAccessOn() {
      return exists(/databases/$(database)/documents/starfish_runs/public_access)
        && get(/databases/$(database)/documents/starfish_runs/public_access).data.get('enabled', false) == true
        && get(/databases/$(database)/documents/starfish_runs/public_access).data.get('environment', '') == 'demo';
    }

    // isGuest() is evaluated first, so an operator's read never pays for the gate's lookup.
    function openGuestGet() {
      return guestGet() && publicAccessOn();
    }

    function openGuestList() {
      return guestList() && publicAccessOn();
    }

    // Operators read only their own record. Roles are granted from the Admin SDK
    // or the console, never by the client.
    match /starfish_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // The operator transitions, the same as nextStatus() in web/src/lib/incidents.ts.
    // Checked against the STORED status, so a stale browser tab can't overwrite
    // another operator's decision. `logged` is never a target: only the engine
    // sets it, when it files the incident's issue or opens its PR
    // (src/agent/incidentLinks.ts), and a logged incident can still be
    // acknowledged (what stops a phone escalation). `recurred` likewise: only
    // the engine re-opens a resolved incident, when its error actually fires
    // again (src/ingest/store.ts). An
    // operator can't reopen a resolved incident; `recurred` is open, so it can be
    // acknowledged (#410), resolved or ignored like any other open incident.
    function validTransition(from, to) {
      return (from in ['new', 'logged', 'recurred'] && to == 'acknowledged')
        || (from in ['new', 'acknowledged', 'logged', 'recurred'] && to in ['resolved', 'ignored'])
        || (from == 'ignored' && to == 'new');
    }

    match /incidents/{incidentId} {
      // Operators; a guest reads the trimmed copy in starfish_public_incidents (#18), or, with the public demo's open
      // reads on, the demo's stored incidents too.
      allow get: if isOperator() || openGuestGet();
      allow list: if isOperator() || openGuestList();

      // Triage only: status and its bookkeeping, nothing else, attributed to the
      // caller and stamped by the server. `resolvedAt` exists exactly when the
      // incident is resolved, and is the server's time.
      allow update: if isOperator()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'statusChangedBy', 'resolvedAt'])
        && validTransition(resource.data.status, request.resource.data.status)
        // A retired incident is closed for good (src/ingest/retire.ts): no more triage.
        && resource.data.get('retired', false) != true
        && request.resource.data.statusChangedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == 'resolved'
              ? request.resource.data.resolvedAt == request.time
              : !('resolvedAt' in request.resource.data));

      // A retriage request (#8, #317): ask the agent to run an incident's declined, or waiting-for-a-person,
      // cycle again (src/agent/reconsider.ts). Only the request's time, the server's, and who
      // asked, the caller: nothing about the incident itself, and only on an open,
      // unretired one, so it can never reopen what an operator resolved or ignored.
      // The engine still bounds how often it acts on one (a cap per 24 hours).
      allow update: if isOperator()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['retriageRequestedAt', 'retriageRequestedBy'])
        && request.resource.data.retriageRequestedAt == request.time
        && request.resource.data.retriageRequestedBy == request.auth.uid
        // The open statuses: OPEN_INCIDENT_STATUSES in src/types.ts. Change both together.
        && resource.data.status in ['new', 'acknowledged', 'logged', 'recurred']
        && resource.data.get('retired', false) != true;

      // A correction (the feedback engine, src/triageRules.ts): an operator says how far Starfish should have gone with
      // this incident, at most. It only ever caps the engine (a level below what triage chose holds it back; `merge`
      // holds nothing back), never raises it. Written in ONE batch with its history entry, which must be new: the
      // incident keeps the latest correction, `corrections` keeps every one. Allowed whatever the status (a correction of
      // a resolved incident is still feedback), but never on a retired one. The levels: LEVELS in src/triageRules.ts.
      allow update: if isOperator()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['correctedLevel', 'correctedBy', 'correctedAt', 'correctionNote', 'correctionId'])
        && request.resource.data.correctedLevel in ['noise', 'log', 'fix', 'merge']
        && request.resource.data.correctedBy == request.auth.uid
        && request.resource.data.correctedAt == request.time
        && (!('correctionNote' in request.resource.data)
            || (request.resource.data.correctionNote is string
                && request.resource.data.correctionNote.size() >= 1 && request.resource.data.correctionNote.size() <= 300))
        && request.resource.data.correctionId is string
        && request.resource.data.correctionId.size() >= 8 && request.resource.data.correctionId.size() <= 64
        && !exists(/databases/$(database)/documents/incidents/$(incidentId)/corrections/$(request.resource.data.correctionId))
        && existsAfter(/databases/$(database)/documents/incidents/$(incidentId)/corrections/$(request.resource.data.correctionId))
        && resource.data.get('retired', false) != true;

      // Incidents are created and removed by the engine only.
      allow create, delete: if false;

      // The correction history: immutable, each entry equal to the correction it was written with.
      match /corrections/{correctionId} {
        // An entry has no environment of its own: a guest with the open reads on reads those of a demo incident.
        allow get: if isOperator()
          || (isGuest() && publicAccessOn()
              && get(/databases/$(database)/documents/incidents/$(incidentId)).data.get('environment', '') == 'demo');
        allow list: if isOperator()
          || (isGuest() && publicAccessOn()
              && get(/databases/$(database)/documents/incidents/$(incidentId)).data.get('environment', '') == 'demo'
              && request.query.limit is int && request.query.limit <= 500);
        allow create: if isOperator()
          && request.resource.data.keys().hasOnly(['level', 'by', 'at', 'note'])
          && request.resource.data.keys().hasAll(['level', 'by', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/incidents/$(incidentId)).data.correctionId == correctionId
          && getAfter(/databases/$(database)/documents/incidents/$(incidentId)).data.correctedLevel == request.resource.data.level
          && getAfter(/databases/$(database)/documents/incidents/$(incidentId)).data.get('correctionNote', null)
               == request.resource.data.get('note', null);
        allow update, delete: if false;
      }
    }

    // ---- Runtime settings (src/runtimeSettings.ts) --------------------------
    //
    // Three documents change together, in ONE batch, and each rule checks the
    // other two with getAfter(), so none can be written alone:
    //   starfish_settings/current          what the engine runs on. Admins only.
    //   starfish_settings_audit/{auditId}  who changed what, when. Immutable.
    //   starfish_settings_public/current   the copy operators and guests may read.
    // Reads of a document are all-or-nothing, so the operator copy is a separate
    // document holding only what the UI needs, not a redacted view of this one:
    // the environment label, the watched project, and the settings fields (never the
    // bookkeeping: auditId, updatedBy) for the read-only Settings view.
    //
    // Not here: secrets (they are never stored in Firestore: any key outside the
    // list below is rejected), and starfish_settings/last_good, the engine's own
    // copy, which only the Admin SDK touches. Rules have no loops, so they check
    // the shape and size of each list but not every entry; the engine validates
    // entries on read and falls back to the last good document if one is bad.
    // `current` can't be deleted from a client: a reset saves an empty settings
    // document, which keeps revisions counting up and the audit trail whole.

    function settingsDoc() {
      return /databases/$(database)/documents/starfish_settings/current;
    }

    function publicSettingsDoc() {
      return /databases/$(database)/documents/starfish_settings_public/current;
    }

    function auditDoc(auditId) {
      return /databases/$(database)/documents/starfish_settings_audit/$(auditId);
    }

    // The settings fields: FIELD_NAMES in web/src/lib/settingsForm.ts, and src/settingsSchema.ts.
    function settingsFields() {
      return ['watchedProjectId', 'environment', 'logResourceTypes', 'servicePatterns', 'ignoredMessages',
              'dryRun', 'reviewRequired', 'automationEnabled', 'autoMerge', 'mergeFreeze', 'mergeCases', 'classRules',
              'modelCallBudget', 'model', 'location', 'vertexProjectId'];
    }

    function settingsShapeOk(d) {
      return d.keys().hasOnly(settingsFields().concat(['version', 'revision', 'auditId', 'updatedAt', 'updatedBy']))
        && d.keys().hasAll(['version', 'revision', 'auditId', 'updatedAt', 'updatedBy'])
        && d.version == 1
        && d.revision is int
        && d.auditId is string && d.auditId.size() >= 8 && d.auditId.size() <= 64
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && (!('watchedProjectId' in d)
            || (d.watchedProjectId is string && d.watchedProjectId.matches('^[a-z][a-z0-9-]{4,28}[a-z0-9]$')))
        && (!('environment' in d)
            || (d.environment is string && d.environment.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$')))
        && (!('logResourceTypes' in d)
            || (d.logResourceTypes is list && d.logResourceTypes.size() >= 1 && d.logResourceTypes.size() <= 20))
        && (!('servicePatterns' in d) || (d.servicePatterns is map && d.servicePatterns.size() <= 100))
        && (!('ignoredMessages' in d) || (d.ignoredMessages is list && d.ignoredMessages.size() <= 100))
        && (!('dryRun' in d) || d.dryRun is bool)
        && (!('reviewRequired' in d) || d.reviewRequired is bool)
        && (!('automationEnabled' in d) || d.automationEnabled is bool)
        && (!('autoMerge' in d) || d.autoMerge is bool)
        && (!('mergeFreeze' in d) || d.mergeFreeze is bool)
        // MAX_MERGE_CASES in src/settingsSchema.ts; each case's id and description are checked by the engine on read.
        && (!('mergeCases' in d) || (d.mergeCases is list && d.mergeCases.size() <= 20))
        // MAX_CLASS_RULES in src/triageRules.ts; each rule is checked by the engine on read (validateClassRules).
        && (!('classRules' in d) || (d.classRules is list && d.classRules.size() <= 50))
        && (!('modelCallBudget' in d) || (d.modelCallBudget is int && d.modelCallBudget >= 1 && d.modelCallBudget <= 50))
        // The same patterns as MODEL_ID and VERTEX_LOCATION in src/settingsSchema.ts.
        && (!('model' in d) || (d.model is string && d.model.matches('^[a-z][a-z0-9._-]{0,63}$')))
        && (!('location' in d)
            || (d.location is string && d.location.matches('^(global|[a-z]{2,20}-[a-z]{2,20}[0-9]{1,2})$')))
        // PROJECT_ID in src/settingsSchema.ts, as for watchedProjectId.
        && (!('vertexProjectId' in d)
            || (d.vertexProjectId is string && d.vertexProjectId.matches('^[a-z][a-z0-9-]{4,28}[a-z0-9]$')));
    }

    // The change being written also creates its audit entry (new in this batch, so
    // an old one can't be pointed at) and brings the operator copy to this revision.
    function changeRecorded(d) {
      return !exists(auditDoc(d.auditId))
        && existsAfter(auditDoc(d.auditId))
        && existsAfter(publicSettingsDoc())
        && getAfter(publicSettingsDoc()).data.revision == d.revision;
    }

    match /starfish_settings/current {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && settingsShapeOk(request.resource.data)
        && request.resource.data.revision == 1
        && changeRecorded(request.resource.data);

      // Each save is revision + 1 of what the admin saw, so a stale tab can't
      // overwrite another admin's change. A document made from the console has no
      // revision; the first save from the UI is then revision 1.
      allow update: if isAdmin()
        && settingsShapeOk(request.resource.data)
        && request.resource.data.revision == resource.data.get('revision', 0) + 1
        && changeRecorded(request.resource.data);

      allow delete: if false;
    }

    // Written with its change, and equal to what that change put in `current`.
    match /starfish_settings_audit/{auditId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['revision', 'by', 'at', 'before', 'after'])
        && request.resource.data.keys().hasAll(['revision', 'by', 'at', 'before', 'after'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && existsAfter(settingsDoc())
        && getAfter(settingsDoc()).data.auditId == auditId
        && request.resource.data.revision == getAfter(settingsDoc()).data.revision
        && request.resource.data.after == getAfter(settingsDoc()).data
        && request.resource.data.before == (exists(settingsDoc()) ? get(settingsDoc()).data : null);

      allow update, delete: if false;
    }

    // What operators may know: the environment label the UI filters incidents by,
    // the watched project's id, and `settings`, the settings fields of `current` for
    // the read-only Settings view. Each equal to the same fields of `current`.
    match /starfish_settings_public/current {
      // Guests read it too: the UI needs the environment label to ask for the right incidents,
      // and the public demo shows the settings in force, read-only. Nothing in it is a secret.
      allow read: if isOperator() || isGuest();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['version', 'revision', 'watchedProjectId', 'environment', 'updatedAt', 'settings'])
        && request.resource.data.keys().hasAll(['version', 'revision', 'updatedAt', 'settings'])
        // `settings` is `current` minus its bookkeeping: no field added, left out or changed.
        && request.resource.data.settings is map
        && request.resource.data.settings.keys().hasOnly(settingsFields())
        && request.resource.data.settings.diff(getAfter(settingsDoc()).data).affectedKeys()
             .hasOnly(['version', 'revision', 'auditId', 'updatedAt', 'updatedBy'])
        && request.resource.data.version == 1
        && existsAfter(settingsDoc())
        && request.resource.data.revision == getAfter(settingsDoc()).data.revision
        && request.resource.data.updatedAt == getAfter(settingsDoc()).data.updatedAt
        && request.resource.data.get('watchedProjectId', null) == getAfter(settingsDoc()).data.get('watchedProjectId', null)
        && request.resource.data.get('environment', null) == getAfter(settingsDoc()).data.get('environment', null);

      allow delete: if false;
    }

    // ---- Ingest runs (src/ingest/run.ts) -------------------------------------
    //
    // starfish_runs/last_run  the outcome of the latest run, for the UI: when it ran, over what
    //                         window, what it found, whether it was capped or failed. Counts and
    //                         field names only, never log text.
    // starfish_runs/state_<h> the checkpoint and the window in flight, one per (watched project,
    //                         environment); `state` is the pre-#198 single one, moved on first write.
    //                         Engine-only: a client that could move it could make the engine skip or
    //                         re-read stretches of logs.
    // Clients never write either. A guest reads last_run only for the demo environment, like the trimmed copies.
    match /starfish_runs/last_run {
      allow get: if isOperator() || guestGet();
      allow list: if isOperator() || guestList();
      allow write: if false;
    }

    // starfish_runs/integrations  which credentials the agent job holds (src/agent/integrations.ts): booleans
    //                         and a time, never a value. Read like last_run; only the engine writes.
    match /starfish_runs/integrations {
      allow get: if isOperator() || guestGet();
      allow list: if isOperator() || guestList();
      allow write: if false;
    }

    // starfish_runs/agent_last_run  the outcome of the latest agent pass (src/agent/lastRun.ts, #274): when it ran,
    //                         how it went, counts, enumerated step labels and its interval; never a message or an
    //                         incident's text. Read like last_run; only the engine writes.
    match /starfish_runs/agent_last_run {
      allow get: if isOperator() || guestGet();
      allow list: if isOperator() || guestList();
      allow write: if false;
    }

    // ---- Agent cycles (src/agent/cycle.ts) -----------------------------------
    //
    // starfish_cycles/{incident}_r{n}          one cycle: its state, stage and lease holder.
    // starfish_cycles/{id}/events/{seq}        the run events the Live runs screen renders.
    // Operators only: a guest reads the trimmed copies in starfish_public_cycles and
    // starfish_public_events (#18). Only the engine writes: the lease is what stops two workers
    // acting on a cycle, and a client that could touch it could make the engine act twice or not
    // at all. Events hold redacted, bounded text.
    // With the public demo's open reads on (publicAccessOn), a guest reads the demo's stored cycles and events too.
    match /starfish_cycles/{cycleId} {
      allow get: if isOperator() || openGuestGet();
      allow list: if isOperator() || openGuestList();
      allow write: if false;

      match /events/{seq} {
        allow get: if isOperator() || openGuestGet();
        allow list: if isOperator() || openGuestList();
        allow write: if false;
      }

      // starfish_cycles/{id}/checkpoints/verified   engine-only (#450): the patch the round's verify gate passed, kept so a
      // resumed attempt goes straight to review. Closed to every client, admins and the public demo's open reads
      // included: the cycle document deliberately holds no patch, and no guest copy carries one.
      // Explicit, though the closing rule would refuse it too: no later rule may open it.
      match /checkpoints/{checkpointId} {
        allow read, write: if false;
      }
    }

    // The Overview's activity feed for operators: the newest events across every cycle, one
    // collection-group query (web/src/lib/runs.ts). A collection-group rule matches an `events`
    // collection at any depth, so it grants `list` only (a single read stays with the rule above).
    // The engine writes `events` only under starfish_cycles; the UI also drops any result whose path
    // is not a cycle's. A guest's feed reads starfish_public_events instead.
    match /{path=**}/events/{seq} {
      allow list: if isOperator() || openGuestList();
    }

    // ---- The guests' trimmed copies (src/publicView.ts, src/publicViewStore.ts, #18) ----------------
    //
    // starfish_public_incidents/{incidentId}        the copy of an incident of a public environment
    // starfish_public_cycles/{cycleId}              the copy of a cycle and its run record's enumerated values
    // starfish_public_events/{cycleId}_{seq}        the copy of a run event, never its data
    // Written by the engine only, from an allowlist (STARFISH_PUBLIC_ENVIRONMENTS, `demo` by default).
    // A guest reads the demo's, as before: a list must filter on environment == 'demo'. Nobody in the
    // browser writes them; an operator may read them too, and still reads the full documents above.
    match /starfish_public_incidents/{incidentId} {
      allow get: if isOperator() || guestGet();
      allow list: if isOperator() || guestList();
      allow write: if false;
    }

    match /starfish_public_cycles/{cycleId} {
      allow get: if isOperator() || guestGet();
      allow list: if isOperator() || guestList();
      allow write: if false;
    }

    match /starfish_public_events/{eventId} {
      allow get: if isOperator() || guestGet();
      allow list: if isOperator() || guestList();
      allow write: if false;
    }

    // ---- Admin actions on the engine (src/ingest/retire.ts, trigger.ts, src/oncall/optIn.ts) ----
    //
    // starfish_audit/{id}   who did what to which incident or on-call person, when and why. Admins read
    //                       it; only the engine writes it, before or in the same transaction as the action
    //                       it records. The on-call opt-in entries hold no phone number and no code (#172).
    match /starfish_audit/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- On-call people and policy (#37, src/oncall/) -----------------------------
    //
    // starfish_oncall/policy               when Starfish may phone: the admin's switch, the wait after the Slack
    //                                      message, quiet hours, the per-person daily cap, what counts as critical.
    // starfish_oncall_people/{personId}    a person on the rota: name, role and PHONE NUMBER. Personal data: admins
    //                                      only, never guests or plain operators (which is why it is not in the runtime
    //                                      settings, whose operator copy anyone signed in may read). The UI shows it masked.
    // starfish_oncall_codes/{id}           engine-only (#302, #306): a code's hash, expiry and wrong tries per person,
    //                                      and the deployment's count of opt-in texts per UTC day (`texts.<day>`).
    //                                      Closed to every client, admins included: a six-digit code's hash an admin
    //                                      could read would be undone offline, confirming a number its owner never
    //                                      agreed to.
    // A client creates a person only as `pending`, and changing a number makes it `pending` again: only the engine
    // (src/oncall/optIn.ts, the Admin SDK) marks a number `confirmed`, when its owner read back the code it texted.
    // The call sequences (starfish_escalations) are engine-only: the closing rule.
    // Same names as STARFISH_ONCALL_COLLECTION / STARFISH_ONCALL_PEOPLE_COLLECTION / STARFISH_ONCALL_CODE_COLLECTION;
    // change them together.
    function onCallPersonFieldsOk(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.role in ['primary', 'secondary', 'support-lead']
        // E164_RE in src/oncallSchema.ts.
        && d.phone is string && d.phone.matches('^[+][1-9][0-9]{6,14}$')
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /starfish_oncall_people/{personId} {
      allow read, delete: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'role', 'phone', 'state', 'createdAt', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['name', 'role', 'phone', 'state', 'createdAt', 'updatedAt', 'updatedBy'])
        && onCallPersonFieldsOk(request.resource.data)
        && request.resource.data.state == 'pending'
        && request.resource.data.createdAt == request.time;

      // Name, role and number only. A new number is unconfirmed; otherwise the confirmation state is the engine's.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'phone', 'state', 'updatedAt', 'updatedBy'])
        && onCallPersonFieldsOk(request.resource.data)
        && (request.resource.data.phone != resource.data.phone
              ? request.resource.data.state == 'pending'
              : request.resource.data.state == resource.data.state);
    }

    // Explicit, though the closing rule would refuse it too: this collection must never be opened by a later rule.
    match /starfish_oncall_codes/{codeId} {
      allow read, write: if false;
    }

    match /starfish_oncall/policy {
      allow read: if isAdmin();
      allow delete: if false;
      // parsePolicy in src/oncallSchema.ts: the engine validates again on read and places no call on an invalid one.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'waitMinutes', 'quietStart', 'quietEnd', 'timeZone',
                                                 'dailyCapPerPerson', 'criticalOccurrences', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!('enabled' in request.resource.data) || request.resource.data.enabled is bool)
        && (!('waitMinutes' in request.resource.data)
            || (request.resource.data.waitMinutes is int && request.resource.data.waitMinutes >= 1 && request.resource.data.waitMinutes <= 240))
        && (!('quietStart' in request.resource.data)
            || (request.resource.data.quietStart is string && request.resource.data.quietStart.matches('^(([01][0-9]|2[0-3]):[0-5][0-9])?$')))
        && (!('quietEnd' in request.resource.data)
            || (request.resource.data.quietEnd is string && request.resource.data.quietEnd.matches('^(([01][0-9]|2[0-3]):[0-5][0-9])?$')))
        && (!('timeZone' in request.resource.data)
            || (request.resource.data.timeZone is string && request.resource.data.timeZone.size() >= 1 && request.resource.data.timeZone.size() <= 64))
        && (!('dailyCapPerPerson' in request.resource.data)
            || (request.resource.data.dailyCapPerPerson is int && request.resource.data.dailyCapPerPerson >= 1 && request.resource.data.dailyCapPerPerson <= 20))
        && (!('criticalOccurrences' in request.resource.data)
            || (request.resource.data.criticalOccurrences is int && request.resource.data.criticalOccurrences >= 1 && request.resource.data.criticalOccurrences <= 1000000));
    }

    // Everything else is closed (including the starfish_runs state documents and starfish_escalations).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
