{
  "name": "starfish",
  "version": "0.0.1",
  "private": true,
  "description": "An AI ops engineer for teams that don't have one \u2014 incident to verified pull request, on Google Cloud.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "spike": "tsx src/spike.ts",
    "scrub": "tsx src/scrubCli.ts",
    "scoreboard": "tsx src/scoreboardCli.ts",
    "feedback-corpus": "tsx src/feedbackCorpusCli.ts",
    "seed-demo": "tsx src/seedDemoCli.ts",
    "public-view": "tsx src/publicViewCli.ts",
    "replay": "tsx src/replayCli.ts",
    "ingest": "tsx src/ingestCli.ts",
    "agent": "tsx src/agentCli.ts",
    "escalate": "tsx src/escalateCli.ts",
    "status": "tsx src/statusCli.ts",
    "smoke-check": "tsx src/smokeCheckCli.ts",
    "grant-operator": "tsx src/grantOperatorCli.ts",
    "lint": "eslint . && node scripts/check-no-project-ids.mjs",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && pnpm -C web typecheck",
    "test": "vitest run --passWithNoTests && pnpm -C web test",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "verify": "node scripts/verify-gate.mjs",
    "test:emulator": "pnpm dlx firebase-tools@14.27.0 emulators:exec --only firestore --project demo-starfish-rules 'vitest run -c vitest.emulator.config.ts'",
    "build": "pnpm -C web build",
    "dev:emulated": "pnpm dlx firebase-tools@14.27.0 emulators:exec --only auth,firestore --project demo-starfish 'tsx scripts/seed-emulator.mjs &&VITE_USE_EMULATORS=1 VITE_FIREBASE_API_KEY=demo VITE_FIREBASE_AUTH_DOMAIN=demo-starfish.firebaseapp.com VITE_FIREBASE_PROJECT_ID=demo-starfish VITE_FIREBASE_APP_ID=demo VITE_STARFISH_ENV=demo pnpm -C web dev'",
    "audit:contrast": "node scripts/contrast-audit.mjs"
  },
  "dependencies": {
    "@google-cloud/logging": "^12.1.0",
    "@google/genai": "^2.27.0",
    "firebase-admin": "^14.5.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "12.19.0",
    "playwright-core": "1.63.0",
    "globals": "^17.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@<1.13.6": "^1.14.5"
    }
  }
}
