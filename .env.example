# GCP project Starfish runs in: its Firestore store, and the Vertex AI API (enable it here).
GOOGLE_CLOUD_PROJECT=

# GCP project whose Cloud Logging is read for errors. Unset: GOOGLE_CLOUD_PROJECT
# (Starfish watching the project it runs in). One watched project per deployment:
# change STARFISH_ENV with it so two projects' incidents never share a label.
# STARFISH_WATCHED_PROJECT_ID=

# Vertex AI region.
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini model used for triage, fix drafting and adversarial review.
STARFISH_MODEL=gemini-3.1-pro-preview

# Label stamped on every incident. Environments must never share a value —
# this is what stops a dev incident from being treated as a production one.
STARFISH_ENV=dev

# Firestore collection holding incidents, and the database holding it. Starfish uses
# its own named database ("starfish") so its rules and indexes never touch your app's;
# create it once: gcloud firestore databases create --database=starfish --location=<region>
# "(default)" opts back into the default database.
STARFISH_INCIDENT_COLLECTION=incidents
# Collection holding the runtime settings document an admin edits from the UI. The
# values in this file are the defaults; a valid settings document overrides the
# watched project, environment label, log resource types, service patterns and
# noise list. Unset: starfish_settings.
# STARFISH_SETTINGS_COLLECTION=starfish_settings

# Engine-only collection mapping each (environment, fingerprint) to its incident, so
# concurrent ingest runs converge on one document. Unset: incident_keys.
# STARFISH_INCIDENT_KEY_COLLECTION=incident_keys
# STARFISH_DATABASE_ID=starfish

# Substring -> service attribution, "pattern:service,pattern:service".
# A function matching nothing resolves to "platform" rather than being
# attributed to whichever service happens to be listed first.
STARFISH_SERVICE_PATTERNS=

# How far back the first aggregation run looks when no checkpoint exists.
STARFISH_LOOKBACK_HOURS=24

# Cloud Logging resource types whose ERROR entries count, comma-separated.
# Unset: cloud_function,cloud_run_revision.
# STARFISH_LOG_RESOURCE_TYPES=

# ERROR-severity messages that are framework noise, "|"-separated. Unset keeps
# the callable-framework GET-probe defaults; set to empty to suppress nothing.
# STARFISH_IGNORED_MESSAGES=
