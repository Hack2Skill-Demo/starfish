# Firebase web app config. LOCAL DEVELOPMENT ONLY: a build served from Firebase
# Hosting leaves all four unset and reads the config of the project it is hosted
# in from /__/firebase/init.json at startup, so the bundle carries no project.
# Set all four or none (a partial set is an error). Console → Project settings →
# Your apps. These are public identifiers, not secrets; access is enforced by
# Firestore rules (firestore.rules at the repo root).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firestore database holding incidents; must match the engine's STARFISH_DATABASE_ID.
# VITE_STARFISH_DATABASE_ID=starfish

# Must match the engine's STARFISH_INCIDENT_COLLECTION.
VITE_STARFISH_INCIDENT_COLLECTION=incidents

# Collection of operator records: {uid} -> { roles: ["admin" | "operator"] }.
VITE_STARFISH_USERS_COLLECTION=starfish_users

# Runtime settings an admin edits on the Settings page. Must match the engine's
# STARFISH_SETTINGS_COLLECTION; the operator copy and audit trail are stored in
# <name>_public and <name>_audit, as firestore.rules expects.
# VITE_STARFISH_SETTINGS_COLLECTION=starfish_settings

# Where the engine writes its last-run record (must match STARFISH_RUN_COLLECTION), and how
# long after a run finishes the UI calls the engine stopped. Use about three times the
# schedule's interval (the engine does not know its own cadence). Unset: starfish_runs, 90.
# VITE_STARFISH_RUN_COLLECTION=starfish_runs
# VITE_STARFISH_STALE_MINUTES=90

# Where the agent's cycles and their run events are written (must match
# STARFISH_CYCLE_COLLECTION); the Runs page reads them. Unset: starfish_cycles.
# VITE_STARFISH_CYCLE_COLLECTION=starfish_cycles

# Base URL of the admin API (src/adminApi.ts, deployed with DEPLOY_ADMIN_API=1): shows admins a "Run
# ingest now" button and a "Retire" control. Unset: neither control is shown. https only (http on localhost).
# VITE_STARFISH_ADMIN_API_URL=https://starfish-admin-<hash>-uc.a.run.app

# Label shown in the UI for the environment these incidents come from. A
# settings document that sets an environment overrides it once you are signed in.
VITE_STARFISH_ENV=dev

# Region the watched Cloud Functions deploy to (for "Logs" links).
VITE_FUNCTIONS_REGION=us-central1
