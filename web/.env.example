# Firebase web app config for the project Starfish watches (Console → Project
# settings → Your apps). These are public identifiers, not secrets; access is
# enforced by Firestore rules (firestore.rules at the repo root).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firestore database holding incidents; must match the engine's STARFISH_DATABASE_ID.
# VITE_STARFISH_DATABASE_ID=starfish

# Must match the engine's STARFISH_INCIDENT_COLLECTION.
VITE_STARFISH_INCIDENT_COLLECTION=incidents

# Collection of operator records: {uid} -> { roles: ["admin" | "operator" | "viewer"] }.
VITE_STARFISH_USERS_COLLECTION=starfish_users

# Label shown in the UI for the environment these incidents come from.
VITE_STARFISH_ENV=dev

# Region the watched Cloud Functions deploy to (for "Logs" links).
VITE_FUNCTIONS_REGION=us-central1

# Curated synthetic evidence for read-only viewers; never point this at incidents.
VITE_STARFISH_DEMO_INCIDENT_COLLECTION=demo_incidents
