# Firebase web app config. LOCAL DEVELOPMENT ONLY: a build served from Firebase
# Hosting leaves all four unset and reads the config of the project it is hosted
# in from /__/firebase/init.json at startup, so the bundle carries no project.
# Set all four or none (a partial set is an error). Console → Project settings →
# Your apps. These are public identifiers, not secrets; access is enforced by
# Firestore rules (firestore.rules at the repo root).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firestore database holding incidents; must match the engine's STARFISH_DATABASE_ID.
# VITE_STARFISH_DATABASE_ID=starfish

# Must match the engine's STARFISH_INCIDENT_COLLECTION.
VITE_STARFISH_INCIDENT_COLLECTION=incidents

# Collection of operator records: {uid} -> { roles: ["admin" | "operator"] }.
VITE_STARFISH_USERS_COLLECTION=starfish_users

# Runtime settings an admin edits on the Settings page. Must match the engine's
# STARFISH_SETTINGS_COLLECTION; the operator copy and audit trail are stored in
# <name>_public and <name>_audit, as firestore.rules expects.
# VITE_STARFISH_SETTINGS_COLLECTION=starfish_settings

# Where the engine writes its last-run record (must match STARFISH_RUN_COLLECTION), and how
# long after a run finishes the UI calls the engine stopped. Use about three times the
# schedule's interval (the engine records that interval when STARFISH_INGEST_SCHEDULE is set, but this threshold does
# not follow it). Unset: starfish_runs, 90.
# VITE_STARFISH_RUN_COLLECTION=starfish_runs
# VITE_STARFISH_STALE_MINUTES=90
# How far the ingest's checkpoint may fall behind the newest logs it could read, in minutes, before the engine line
# says "Ingest falling behind" (a sustained flood). Match the engine's STARFISH_INGEST_BEHIND_MINUTES. Unset: twice
# the schedule's interval the run recorded, else the stale threshold.
# VITE_STARFISH_BEHIND_MINUTES=120

# Where the agent's cycles and their run events are written (must match
# STARFISH_CYCLE_COLLECTION); the Runs page reads them. Unset: starfish_cycles.
# VITE_STARFISH_CYCLE_COLLECTION=starfish_cycles

# The trimmed copies a guest (an anonymous session on the public demo) reads instead of the incidents, cycles and run
# events (#18). Must match STARFISH_PUBLIC_INCIDENT_COLLECTION / _CYCLE_ / _EVENT_ and firestore.rules.
# Unset: starfish_public_incidents, starfish_public_cycles, starfish_public_events.
# VITE_STARFISH_PUBLIC_INCIDENT_COLLECTION=starfish_public_incidents
# VITE_STARFISH_PUBLIC_CYCLE_COLLECTION=starfish_public_cycles
# VITE_STARFISH_PUBLIC_EVENT_COLLECTION=starfish_public_events

# The on-call rota for phone escalation (#37): the policy and the people (names, roles, phone numbers), admins only.
# Must match STARFISH_ONCALL_COLLECTION / STARFISH_ONCALL_PEOPLE_COLLECTION and firestore.rules.
# VITE_STARFISH_ONCALL_COLLECTION=starfish_oncall
# VITE_STARFISH_ONCALL_PEOPLE_COLLECTION=starfish_oncall_people

# Base URL of the admin API (src/adminApi.ts, deployed with DEPLOY_ADMIN_API=1): shows admins the "Run
# ingest now" (Incidents) and "Run agent now" (Runs) buttons and a "Retire" control. Unset: none of them is shown. https only (http on localhost).
# VITE_STARFISH_ADMIN_API_URL=https://starfish-admin-<hash>-uc.a.run.app

# Firebase App Check (#12), optional. Unset (the default): App Check is not initialised and the UI, guests included,
# works as before; it then cannot read a database whose App Check enforcement is ON (docs/setup.md). Set: every
# Firestore request and admin API call carries an App Check token. The site key is the reCAPTCHA key registered for this
# web app under App Check (a public identifier, not a secret). PROVIDER: enterprise (default) or v3. Skipped on the
# emulators (VITE_USE_EMULATORS=1), which do not check tokens.
# VITE_STARFISH_APPCHECK_SITE_KEY=
# VITE_STARFISH_APPCHECK_PROVIDER=enterprise
# Local development against a real project with enforcement on: a debug token registered in the console (App Check →
# Apps → Manage debug tokens), or "true" to have the SDK print a new one in the browser console. Honoured only by the
# dev server (`pnpm -C web dev`), never by a production build; it IS a credential, so keep it out of anything you
# deploy (scripts/deploy-web.sh refuses to build with one set).
# VITE_STARFISH_APPCHECK_DEBUG_TOKEN=

# The public demo only (VITE_STARFISH_ENV=demo): one line telling a visitor where the sign-in email and password are,
# shown on the sign-in page and in the welcome guide (never put the credentials themselves here: the value ships in the
# bundle). Unset: "Use the email and password you were given."
# VITE_STARFISH_DEMO_SIGNIN_HINT=They are in our presentation slides.

# The public demo only: where a visitor breaks the watched app on purpose (the demo shop's Lab), linked from the
# Incidents page. https only. Unset: no link.
# VITE_STARFISH_DEMO_APP_URL=https://hack2skill-demo.web.app/#lab

# The public demo only: the source repository, shown as a GitHub mark in the guest bar and on the sign-in page. https
# only. Unset: no link.
# VITE_STARFISH_SOURCE_URL=https://github.com/Hack2Skill-Demo/starfish

# The public demo only: its open actions (src/publicDemo.ts, docs/deploy.md). true (or 1): a visitor with no account
# reads the demo's full records and gets the operator's controls plus "Run ingest now" and "Run agent now", each sent
# to the admin API (VITE_STARFISH_ADMIN_API_URL), never written to Firestore; the guest bar and welcome guide then say
# so, and that the actions are limited per IP address to protect billing. Build with it ONLY once the admin API runs with
# STARFISH_PUBLIC_DEMO_ACTIONS=true (deploy-gcp.sh PUBLIC_DEMO_ACTIONS=true): alone, a visitor's reads are refused.
# Ignored on any build but VITE_STARFISH_ENV=demo. Unset: off, the view-only demo.
# VITE_STARFISH_PUBLIC_DEMO_ACTIONS=true
# The limits the guide quotes. They MUST match the admin API's STARFISH_PUBLIC_ACTIONS_PER_IP_PER_HOUR,
# STARFISH_PUBLIC_RUNS_PER_IP_PER_HOUR and STARFISH_PUBLIC_AGENT_RUNS_PER_HOUR, which are what is enforced; the UI only
# quotes them. Unset: the engine's defaults, 30, 3 and 6.
# VITE_STARFISH_PUBLIC_ACTIONS_PER_IP_PER_HOUR=30
# VITE_STARFISH_PUBLIC_RUNS_PER_IP_PER_HOUR=3
# VITE_STARFISH_PUBLIC_AGENT_RUNS_PER_HOUR=6

# Label shown in the UI for the environment these incidents come from. A
# settings document that sets an environment overrides it once you are signed in.
VITE_STARFISH_ENV=dev

# Region the watched Cloud Functions deploy to (for "Logs" links).
VITE_FUNCTIONS_REGION=us-central1
